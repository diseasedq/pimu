<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ПИМУ — Магистратура | Психология (Полный Академический Курс 2026)</title>
  <meta name="description" content="Полный фундаментальный академический курс подготовки к экзаменам в магистратуру ПИМУ со схемами из NotebookLM, Атласа Гамезо, Рубинштейна и Леонтьева.">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- MATHJAX ENGINE FOR FORMULAS -->
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['\\(', '\\)'], ['$', '$']],
        displayMath: [['\\[', '\\]'], ['$$', '$$']]
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
      }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <style>
    :root {
      --bg-deep: #05070e;
      --bg-surface-1: #0c101c;
      --bg-surface-2: #141a2e;
      --bg-surface-glass: rgba(16, 22, 38, 0.88);
      
      --color-border: rgba(255, 255, 255, 0.08);
      --color-border-glow: rgba(0, 242, 254, 0.35);
      
      --text-primary: #f8fafc;
      --text-secondary: #cbd5e1;
      --text-tertiary: #64748b;
      
      --accent-cyan: #00f2fe;
      --accent-blue: #4facfe;
      --accent-violet: #7000ff;
      --accent-amber: #ffb703;
      --accent-emerald: #10b981;
      --accent-rose: #ff4757;
      
      --grad-primary: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
      --font-display: 'Bricolage Grotesque', sans-serif;
      --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
      
      --radius-xl: 20px;
      --radius-lg: 14px;
      --radius-md: 10px;
      --radius-sm: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: var(--font-body);
      background-color: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.75;
      min-height: 100vh;
      background-image: 
        radial-gradient(at 0% 0%, rgba(112, 0, 255, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(0, 242, 254, 0.1) 0px, transparent 50%);
      background-attachment: fixed;
    }

    h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.02em; color: #fff; }

    .app-viewport { display: flex; min-height: 100vh; }

    /* Sidebar */
    .app-sidebar {
      width: 280px;
      background: rgba(7, 10, 18, 0.95);
      backdrop-filter: blur(16px);
      border-right: 1px solid var(--color-border);
      padding: 28px 18px;
      display: flex;
      flex-direction: column;
      position: fixed;
      height: 100vh;
      z-index: 50;
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 20px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--color-border);
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-md);
      background: var(--grad-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
    }

    .brand-meta .title { font-size: 1.1rem; display: block; font-family: var(--font-display); }
    .brand-meta .subtitle { font-size: 0.725rem; color: var(--accent-cyan); font-weight: 600; text-transform: uppercase; }

    .nav-group { display: flex; flex-direction: column; gap: 6px; flex: 1; }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 0.925rem;
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .nav-link:hover { background: rgba(255, 255, 255, 0.04); color: #fff; }
    .nav-link.active {
      background: linear-gradient(90deg, rgba(0, 242, 254, 0.15), rgba(112, 0, 255, 0.18));
      border-color: rgba(0, 242, 254, 0.3);
      color: #fff;
    }
    .nav-link.active svg { color: var(--accent-cyan); }

    .nav-badge { margin-left: auto; font-size: 0.75rem; padding: 2px 8px; border-radius: 10px; background: rgba(0, 242, 254, 0.15); color: var(--accent-cyan); font-weight: 700; }

    .sidebar-status-box {
      background: var(--bg-surface-glass);
      border: 1px solid var(--color-border);
      padding: 14px;
      border-radius: var(--radius-md);
      margin-top: auto;
    }

    /* Main Area */
    .app-main { margin-left: 280px; flex: 1; padding: 36px 44px; max-width: 1300px; width: calc(100% - 280px); }

    .main-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--color-border); }
    .header-meta h1 { font-size: 2.1rem; margin-bottom: 4px; }
    .header-meta p { color: var(--text-secondary); font-size: 0.95rem; }

    /* Buttons */
    .ui-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .ui-btn-primary { background: var(--grad-primary); color: #fff; box-shadow: 0 4px 18px rgba(0, 242, 254, 0.3); }
    .ui-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0, 242, 254, 0.45); }
    .ui-btn-ghost { background: rgba(255, 255, 255, 0.04); color: var(--text-primary); border-color: var(--color-border); }
    .ui-btn-ghost:hover { background: rgba(255, 255, 255, 0.08); }
    .ui-btn-sm { padding: 6px 12px; font-size: 0.8rem; }
    .ui-btn-lg { padding: 14px 28px; font-size: 1rem; }

    /* Views */
    .view-panel { display: none; }
    .view-panel.active { display: block; animation: fadeIn 0.25s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* Stats Grid */
    .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px; }
    .card-stat {
      background: var(--bg-surface-glass);
      backdrop-filter: blur(12px);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 22px;
    }
    .card-stat-hero { background: linear-gradient(145deg, rgba(112, 0, 255, 0.2), rgba(0, 242, 254, 0.12)); border-color: rgba(0, 242, 254, 0.35); }
    .card-stat-title { font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
    .card-stat-val { font-size: 2.2rem; font-family: var(--font-display); font-weight: 800; margin-bottom: 6px; }

    .progress-track { width: 100%; height: 8px; background: rgba(255, 255, 255, 0.06); border-radius: 4px; overflow: hidden; margin-top: 8px; }
    .progress-fill { height: 100%; background: var(--grad-primary); border-radius: 4px; transition: width 0.4s ease; }

